msgid "Previous"
msgstr "上一首"

msgid "Play or pause"
msgstr "播放或暂停"

msgid "Next"
msgstr "下一首"

msgid "Search again"
msgstr "重新搜索"

msgid "Reset lyrics offset"
msgstr "重置歌词偏移"

msgid "Preferences"
msgstr "设置"

msgid "Unknown title"
msgstr "未知歌曲"

msgid "Unknown artist"
msgstr "未知歌手"

msgid "Searching for lyrics…"
msgstr "正在搜索歌词…"

msgid "Instrumental track"
msgstr "纯音乐"

msgid "No lyrics found"
msgstr "未找到歌词"

msgid "Could not load lyrics"
msgstr "无法加载歌词"

msgid "Unsynchronized lyrics"
msgstr "非同步歌词"

msgid "Offline lyrics cache"
msgstr "离线歌词缓存"

msgid "Choose the correct lyrics"
msgstr "请选择正确的歌词"

msgid "LyricFlow"
msgstr "LyricFlow"

msgid "Top bar"
msgstr "顶栏"

msgid "Choose how synchronized lyrics appear in the GNOME top bar."
msgstr "设置同步歌词在 GNOME 顶栏中的显示方式。"

msgid "Show synchronized lyrics"
msgstr "显示同步歌词"

msgid "Simplified Chinese"
msgstr "简体中文"

msgid "Standard Traditional Chinese"
msgstr "标准繁体"

msgid "Keep source text"
msgstr "保留原文"

msgid "Lyrics text"
msgstr "歌词文字"

msgid "Conversion only changes display text; cached LRCLIB lyrics remain unchanged."
msgstr "转换只影响显示，缓存中的 LRCLIB 歌词原文不会改变。"

msgid "Fall back to the song title when timed lyrics are unavailable."
msgstr "没有时间轴歌词时回退显示歌曲信息。"

msgid "Left"
msgstr "左侧"

msgid "Center"
msgstr "中间"

msgid "Right"
msgstr "右侧"

msgid "Position"
msgstr "位置"

msgid "Maximum width"
msgstr "最大宽度"

msgid "pixels"
msgstr "像素"

msgid "Font scale"
msgstr "字体缩放"

msgid "Marquee speed"
msgstr "长歌词滚动速度"

msgid "pixels per second"
msgstr "像素/秒"

msgid "Track information duration"
msgstr "歌曲信息显示时长"

msgid "seconds"
msgstr "秒"

msgid "Popup appearance"
msgstr "弹窗外观"

msgid "Customize the expanded player and lyrics popup."
msgstr "自定义展开后的播放器和歌词弹窗。"

msgid "Liquid glass"
msgstr "液态玻璃"

msgid "Blur the content behind the popup and use translucent surfaces."
msgstr "模糊弹窗后方的内容，并使用半透明表面。"

msgid "Subtle"
msgstr "轻度"

msgid "Balanced"
msgstr "标准"

msgid "Strong"
msgstr "强烈"

msgid "Glass strength"
msgstr "玻璃强度"

msgid "Stronger levels increase blur and transparency."
msgstr "强度越高，模糊和透明效果越明显。"

msgid "Lyrics timing"
msgstr "歌词时间"

msgid "A positive offset shows lyrics earlier; a negative offset shows them later."
msgstr "正值会让歌词提前显示，负值会让歌词延后显示。"

msgid "Global offset"
msgstr "全局偏移"

msgid "milliseconds"
msgstr "毫秒"

msgid "Reset timing offset"
msgstr "重置时间偏移"

msgid "Restore the default value of 0 milliseconds."
msgstr "恢复为默认的 0 毫秒。"

msgid "Reset"
msgstr "重置"

msgid "Lyrics service"
msgstr "歌词服务"

msgid "LRCLIB and NetEase"
msgstr "LRCLIB 与网易云音乐"

msgid "Song metadata is sent to LRCLIB and, when synchronized lyrics are unavailable, to NetEase. No account, cookie, playback history, or lyric text is sent."
msgstr "歌曲元数据会发送给 LRCLIB；没有同步歌词时会发送给网易云音乐。不会发送账户、Cookie、播放记录或歌词正文。"

msgid "Refreshing lyrics…"
msgstr "正在刷新歌词…"

msgid "Search failed; keeping current lyrics"
msgstr "搜索失败，继续使用当前歌词"

msgid "Cached lyrics"
msgstr "缓存歌词"
