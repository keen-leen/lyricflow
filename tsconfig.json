{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "declaration": false,
    "types": [
      "@girs/gjs",
      "@girs/gnome-shell/ambient",
      "@girs/gnome-shell/extensions/global",
      "@girs/soup-3.0"
    ]
  },
  "include": ["src/**/*.ts"]
}
